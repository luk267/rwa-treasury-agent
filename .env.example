# Environment for the agent. Copy this file to agent/.env.
#
# By default the agent runs against the local Anvil stack. It then signs with a
# fixed Anvil test account that holds AGENT_ROLE and no other role, and needs
# neither an RPC URL nor a private key.

# Anthropic API key for the agent (Claude Messages API).
# Required for every agent run, including against the local Anvil stack.
ANTHROPIC_API_KEY=

# Optional: Claude model ID for the agent. Empty = claude-opus-5-5.
AGENT_MODEL=

# Optional: 1 = skip the "Proceed? [y/N]" prompt before real transfers (same as --yes).
AGENT_AUTO_APPROVE=

# --- Sepolia ---------------------------------------------------------------
# Optional: local (default) or sepolia. sepolia reads deployments/sepolia.json.
AGENT_NETWORK=

# Sepolia RPC endpoint. Required when AGENT_NETWORK=sepolia, and for deploying.
RPC_URL_SEPOLIA=

# The agent's own testnet key. Required when AGENT_NETWORK=sepolia. It must hold
# AGENT_ROLE in the deployed vault and no other role. Never commit a real key.
AGENT_PRIVATE_KEY=

# --- Deployment (read by Foundry, not by the agent) ------------------------
# Put these in contracts/.env (Foundry loads it) or export them in the shell.
# RPC_URL_SEPOLIA from above is needed there as well.

# Signs the deployment. Becomes admin, treasurer, pauser and token issuer on the testnet.
DEPLOYER_PRIVATE_KEY=

# Etherscan API key for verifying the contracts.
ETHERSCAN_API_KEY=
