# Environment for the agent. Copy this file to agent/.env.
#
# The agent runs against the local Anvil stack only. It signs with a fixed Anvil
# test account that holds AGENT_ROLE and no other role, so this file needs no
# RPC URL and no private key.

# Anthropic API key for the agent (Claude Messages API).
# Required for every agent run, including against the local Anvil stack.
ANTHROPIC_API_KEY=

# Optional: Claude model ID for the agent. Empty = claude-opus-5-5.
AGENT_MODEL=

# Optional: 1 = skip the "Proceed? [y/N]" prompt before real transfers (same as --yes).
AGENT_AUTO_APPROVE=
