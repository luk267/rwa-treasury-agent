# Sepolia RPC endpoint (e.g. Alchemy, Infura, or a public node).
# Used by Foundry scripts and the TypeScript agent for read/write calls.
RPC_URL_SEPOLIA=

# Deployer / agent EOA private key (hex, no 0x prefix needed for some tools).
# NEVER commit a real key. Use a fresh testnet key for this repo.
PRIVATE_KEY=

# Anthropic API key for the agent (Claude Messages API).
# Required for every agent run, including against the local Anvil stack.
ANTHROPIC_API_KEY=

# Optional: Claude model ID for the agent. Empty = claude-opus-5-5.
AGENT_MODEL=

# Optional: 1 = skip the "Proceed? [y/N]" prompt before real transfers (same as --yes).
AGENT_AUTO_APPROVE=

# Etherscan API key for contract verification via `forge verify-contract`.
ETHERSCAN_API_KEY=
